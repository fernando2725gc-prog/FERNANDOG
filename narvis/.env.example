# Copia este archivo como .env y llénalo.

# Clave de la API de Claude (https://console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# Carpeta de tu bóveda de Obsidian (la que contiene la carpeta .obsidian).
# Windows: C:\Users\TuNombre\Documents\MiBoveda   macOS: /Users/tunombre/Documents/MiBoveda
OBSIDIAN_VAULT=

# Carpeta dentro de la bóveda donde Narvis guarda notas, resúmenes y noticias.
OBSIDIAN_FOLDER=Narvis

# Opcional
PORT=8000
NEWS_MAX_AGE_HOURS=4
# NARVIS_MODEL=claude-opus-5-5
